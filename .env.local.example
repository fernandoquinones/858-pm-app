# Copy this file to ".env.local" and fill in your keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic (Claude) → console.anthropic.com → API Keys
# Used server-side by /api/generate. Never prefix this with NEXT_PUBLIC.
ANTHROPIC_API_KEY=sk-ant-...

# Slack (optional — turns on the second channel). From api.slack.com/apps → your app.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C0123456789
